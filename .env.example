# Google APIs (service account JSON path)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# Google Search Console
GSC_SITE_URL=https://hbimplants.com/

# Google Business Profile (setup: docs/gbp-setup-walkthrough.md → npm run gbp -- login)
# Set CLIENT_ID + CLIENT_SECRET manually; login writes the rest.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Homepage reviews at build time (Places API — separate from GBP CLI)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Analytics
GA4_PROPERTY_ID=

# GA4 Measurement (for client-side script)
PUBLIC_GA4_MEASUREMENT_ID=

# OpenAI / ChatGPT Ads (setup: docs/openai-ads/ → npm run chatgpt-ads -- status)
# Advertiser API key from Ads Manager → Settings (server-side only — never PUBLIC_)
OPENAI_ADS_API_KEY=
# Conversions API key from Ads Manager → Conversions → Conversion keys (NOT the Ads API key)
# Also set this on Cloudflare Pages (runtime) for functions/api/openai-conversion.js
OPENAI_ADS_CONVERSIONS_API_KEY=
# Pixel ID from Ads Manager → Conversions (client-side; also add as GitHub Actions + Pages env)
PUBLIC_OPENAI_ADS_PIXEL_ID=

# Referrals form (Formspree)
# Example: https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_REFERRALS_URL=
# Optional: Cloudflare Turnstile widget key if enabled in Formspree settings
PUBLIC_TURNSTILE_SITE_KEY=

# Ahrefs (optional)
AHREFS_API_KEY=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PAGES_PROJECT=

# Twilio (via Zapier — document only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
