---
import type { GalleryCase } from '../data/gallery-cases';

interface Props {
  cases: GalleryCase[];
  heading?: string;
}

const { cases, heading = 'Our Work' } = Astro.props;

const sortedCases = [...cases].sort((a, b) => {
  if (a.display !== b.display) return a.display === 'pair' ? -1 : 1;
  return a.order - b.order;
});

const procedures = ['All', ...Array.from(new Set(sortedCases.map((c) => c.procedure))).sort()];
---

<section class="py-12">
  {heading && (
    <h2 class="section-subheading text-center mb-2">{heading}</h2>
  )}
  <p class="text-center text-neutral-mid mb-8 text-sm">
    Individual results may vary. Photos shown with patient consent.
  </p>

  {procedures.length > 2 && (
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="case-filters">
      {procedures.map((proc) => (
        <button
          type="button"
          class="case-filter-btn px-4 py-2 rounded-full text-sm font-semibold border transition-colors duration-200 border-gray-300 text-neutral-mid hover:border-brand-navy hover:bg-brand-light hover:text-brand-navy aria-pressed:bg-brand-navy aria-pressed:border-brand-navy aria-pressed:text-white aria-pressed:hover:bg-brand-navy aria-pressed:hover:text-white"
          data-filter={proc === 'All' ? 'all' : proc}
          aria-pressed={proc === 'All' ? 'true' : 'false'}
        >
          {proc}
        </button>
      ))}
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8" id="case-grid">
    {sortedCases.map((item, index) => (
      <article
        class="case-card group cursor-pointer rounded-2xl border border-neutral-border bg-white shadow-sm hover:shadow-md hover:border-brand-blue/30 transition-all duration-200 overflow-hidden"
        data-index={index}
        data-procedure={item.procedure}
        tabindex="0"
        role="button"
        aria-label={item.caption || `${item.procedure} before and after result`}
      >
        {item.display === 'composite' && item.after ? (
          <div class="relative bg-neutral-100 aspect-[4/3]">
            <img
              src={item.after.src}
              alt={item.after.alt}
              width="800"
              height="600"
              loading="lazy"
              style={item.after.objectPosition ? `object-position: ${item.after.objectPosition}` : undefined}
              class="w-full h-full object-contain group-hover:scale-[1.01] transition-transform duration-300"
            />
            <span class="absolute bottom-2 left-2 bg-brand-navy/90 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full pointer-events-none">
              Before &amp; After
            </span>
          </div>
        ) : (
          <div class="grid grid-cols-2 divide-x divide-neutral-border bg-neutral-100">
            <div class="relative min-h-0">
              <span class="absolute bottom-2 left-2 z-10 bg-black/55 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded pointer-events-none">
                Before
              </span>
              <div class="aspect-square overflow-hidden bg-neutral-200">
                {item.before ? (
                  <img
                    src={item.before.src}
                    alt={item.before.alt}
                    width="400"
                    height="400"
                    loading="lazy"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-neutral-mid text-xs bg-neutral-200">—</div>
                )}
              </div>
            </div>
            <div class="relative min-h-0">
              <span class="absolute bottom-2 right-2 z-10 bg-brand-gold/95 text-brand-navy text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded pointer-events-none">
                After
              </span>
              <div class="aspect-square overflow-hidden bg-neutral-200">
                {item.after ? (
                  <img
                    src={item.after.src}
                    alt={item.after.alt}
                    width="400"
                    height="400"
                    loading="lazy"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-neutral-mid text-xs bg-neutral-200">—</div>
                )}
              </div>
            </div>
          </div>
        )}


        <div class="px-4 py-4 border-t border-neutral-border bg-surface-2/60 space-y-1.5">
          <span class="block text-[11px] font-semibold uppercase tracking-wide text-brand-blue">
            {item.procedure}
          </span>
          {item.caption ? (
            <h3 class="font-serif text-base font-semibold text-brand-navy leading-snug">{item.caption}</h3>
          ) : (
            <h3 class="font-serif text-base font-semibold text-brand-navy/50 leading-snug italic">Untitled case</h3>
          )}
        </div>
      </article>
    ))}
  </div>

  <p class="text-center text-neutral-mid text-xs mt-8" id="case-empty" style="display:none;">
    No cases in this category yet.
  </p>
</section>

<!-- Lightbox -->
<div
  id="case-lightbox"
  class="fixed inset-0 z-50 hidden bg-black/70 items-center justify-center p-3 sm:p-5"
  role="dialog"
  aria-modal="true"
  aria-label="Case lightbox"
  aria-hidden="true"
>
  <div
    id="case-lb-panel"
    class="relative flex flex-col w-full max-w-[min(96vw,1200px)] max-h-[92vh] bg-white rounded-2xl shadow-2xl overflow-hidden min-h-0"
  >
    <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-2 border-b border-neutral-border shrink-0">
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="case-lb-prev"
          class="p-2 rounded-lg text-brand-navy hover:bg-brand-light transition-colors disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Previous case"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="case-lb-next"
          class="p-2 rounded-lg text-brand-navy hover:bg-brand-light transition-colors disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Next case"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
      <p id="case-lb-counter" class="text-xs text-neutral-mid font-medium tabular-nums"></p>
      <button
        type="button"
        id="case-lb-close"
        class="p-2 rounded-lg text-brand-navy hover:bg-brand-light transition-colors"
        aria-label="Close lightbox"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div id="case-lb-body" class="flex-1 min-h-0 overflow-y-auto flex flex-col transition-opacity duration-200 ease-out">
      <div id="case-lb-images" class="case-lb-images" aria-live="polite"></div>
      <div class="px-4 sm:px-5 py-2.5 border-t border-neutral-border bg-white shrink-0 space-y-0.5">
        <span id="case-lb-tag" class="block text-[11px] font-semibold uppercase tracking-wide text-brand-blue"></span>
        <p id="case-lb-title" class="font-serif text-sm sm:text-base font-semibold text-brand-navy leading-snug"></p>
      </div>
    </div>
  </div>
</div>

<style>
  #case-lb-body.is-fading {
    opacity: 0;
  }
  .case-lb-images {
    display: grid;
    grid-template-columns: 1fr;
    background-color: #f3f4f6;
    min-height: 8rem;
    max-width: 100%;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .case-lb-images {
      grid-template-columns: 1fr 1fr;
    }
    .case-lb-images.is-single,
    .case-lb-images.is-composite {
      grid-template-columns: 1fr;
    }
  }
  .case-lb-images.is-single :global(.case-lb-cell),
  .case-lb-images.is-composite :global(.case-lb-cell) {
    grid-column: 1 / -1;
  }
  .case-lb-images :global(.case-lb-cell) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e5e7eb;
    line-height: 0;
    overflow: hidden;
    max-width: 100%;
    max-height: min(calc(92vh - 7.5rem), 720px);
  }
  .case-lb-images :global(.case-lb-cell + .case-lb-cell) {
    border-top: 1px solid #e5e7eb;
  }
  @media (min-width: 640px) {
    .case-lb-images :global(.case-lb-cell + .case-lb-cell) {
      border-top: none;
      border-left: 1px solid #e5e7eb;
    }
    .case-lb-images.is-composite :global(.case-lb-cell + .case-lb-cell) {
      border-left: none;
    }
  }
  .case-lb-images :global(.case-lb-cell img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(calc(92vh - 7.5rem), 720px);
    object-fit: contain;
  }
  .case-lb-images.is-single :global(.case-lb-cell img),
  .case-lb-images.is-composite :global(.case-lb-cell img) {
    max-width: min(100%, 1100px);
    margin: 0 auto;
  }
  .case-lb-images :global(.case-lb-label) {
    position: absolute;
    bottom: 6px;
    left: auto;
    right: auto;
    z-index: 10;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    pointer-events: none;
  }
  .case-lb-images :global(.case-lb-label--before) {
    left: 6px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
  }
  .case-lb-images :global(.case-lb-label--after) {
    right: 6px;
    background: rgba(201, 168, 76, 0.95);
    color: #1b3828;
  }
  .case-lb-images :global(.case-lb-label--composite) {
    left: 6px;
    background: rgba(27, 56, 40, 0.9);
    color: #fff;
    border-radius: 9999px;
    padding: 4px 10px;
  }
</style>

<script define:vars={{ cases: sortedCases }}>
  (() => {
    const grid = document.getElementById('case-grid');
    const lightbox = document.getElementById('case-lightbox');
    const lbImages = document.getElementById('case-lb-images');
    const lbBody = document.getElementById('case-lb-body');
    const lbTitle = document.getElementById('case-lb-title');
    const lbTag = document.getElementById('case-lb-tag');
    const lbCounter = document.getElementById('case-lb-counter');
    const lbClose = document.getElementById('case-lb-close');
    const lbPrev = document.getElementById('case-lb-prev');
    const lbNext = document.getElementById('case-lb-next');
    const emptyMsg = document.getElementById('case-empty');
    const filterBtns = document.querySelectorAll('.case-filter-btn');

    if (!grid || !lightbox || !lbImages || !lbBody) return;

    const allCards = Array.from(grid.querySelectorAll('.case-card'));
    let visibleIndices = allCards.map((_, i) => i);
    let currentPos = 0;
    let isTransitioning = false;
    const FADE_MS = 200;

    function applyFilter(filter) {
      visibleIndices = [];
      allCards.forEach((el, i) => {
        const proc = el.dataset.procedure ?? '';
        const visible = filter === 'all' || proc === filter;
        el.style.display = visible ? '' : 'none';
        if (visible) visibleIndices.push(i);
      });
      if (emptyMsg) emptyMsg.style.display = visibleIndices.length === 0 ? 'block' : 'none';
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        applyFilter(btn.dataset.filter ?? 'all');
      });
    });

    function imgStyle(img) {
      return img.objectPosition ? `object-position:${img.objectPosition}` : '';
    }

    function lightboxImages(item) {
      if (item.display === 'composite' && item.after) return [item.after];
      return [item.before, item.after].filter(Boolean);
    }

    function preloadImages(imgs) {
      return Promise.all(
        imgs.map(
          (img) =>
            new Promise((resolve) => {
              const el = new Image();
              el.onload = () => resolve();
              el.onerror = () => resolve();
              el.src = img.src;
            }),
        ),
      );
    }

    function preloadAdjacent() {
      [-1, 1].forEach((offset) => {
        const pos = currentPos + offset;
        if (pos < 0 || pos >= visibleIndices.length) return;
        preloadImages(lightboxImages(cases[visibleIndices[pos]]));
      });
    }

    function addOverlayLabel(cell, role) {
      const label = document.createElement('span');
      if (role === 'before') {
        label.className = 'case-lb-label case-lb-label--before';
        label.textContent = 'Before';
      } else if (role === 'after') {
        label.className = 'case-lb-label case-lb-label--after';
        label.textContent = 'After';
      } else {
        label.className = 'case-lb-label case-lb-label--composite';
        label.textContent = 'Before & After';
      }
      cell.appendChild(label);
    }

    function buildImageCell(img) {
      const cell = document.createElement('div');
      cell.className = 'case-lb-cell';
      addOverlayLabel(cell, img.role);
      const image = document.createElement('img');
      image.src = img.src;
      image.alt = img.alt;
      image.decoding = 'async';
      const pos = imgStyle(img);
      if (pos) image.style.cssText = pos;
      cell.appendChild(image);
      return cell;
    }

    function renderLightboxImages(item, imgs) {
      lbImages.replaceChildren();
      lbImages.classList.toggle('is-composite', item.display === 'composite');
      lbImages.classList.toggle('is-single', imgs.length === 1);
      if (imgs.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'col-span-full p-8 text-center text-sm text-neutral-mid';
        empty.textContent = 'Images unavailable for this case.';
        lbImages.appendChild(empty);
        return;
      }
      imgs.forEach((img) => lbImages.appendChild(buildImageCell(img)));
    }

    function updateCaption(item) {
      if (lbTitle) lbTitle.textContent = item.caption || '';
      if (lbTag) lbTag.textContent = item.procedure;
      if (lbCounter) lbCounter.textContent = `${currentPos + 1} / ${visibleIndices.length}`;
      if (lbPrev) lbPrev.disabled = currentPos === 0;
      if (lbNext) lbNext.disabled = currentPos === visibleIndices.length - 1;
    }

    async function showCase(animate = false) {
      const globalIndex = visibleIndices[currentPos];
      const item = cases[globalIndex];
      if (!item) return;

      const imgs = lightboxImages(item);
      if (animate && !lightbox.classList.contains('hidden')) {
        if (isTransitioning) return;
        isTransitioning = true;
        lbBody.classList.add('is-fading');
        await new Promise((r) => setTimeout(r, FADE_MS));
        await preloadImages(imgs);
        renderLightboxImages(item, imgs);
        updateCaption(item);
        lbBody.classList.remove('is-fading');
        isTransitioning = false;
      } else {
        await preloadImages(imgs);
        renderLightboxImages(item, imgs);
        updateCaption(item);
      }
      preloadAdjacent();
    }

    function setLightboxOpen(open) {
      lightbox.classList.toggle('hidden', !open);
      lightbox.classList.toggle('flex', open);
      lightbox.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function openLightbox(globalIndex) {
      const pos = visibleIndices.indexOf(globalIndex);
      if (pos === -1) return;
      currentPos = pos;
      setLightboxOpen(true);
      showCase(false);
      lbClose?.focus();
    }

    function closeLightbox() {
      setLightboxOpen(false);
      lbBody.classList.remove('is-fading');
      isTransitioning = false;
    }

    function goToCase(delta) {
      const next = currentPos + delta;
      if (next < 0 || next >= visibleIndices.length) return;
      currentPos = next;
      showCase(true);
    }

    allCards.forEach((el, i) => {
      el.addEventListener('mouseenter', () => {
        lightboxImages(cases[i]).forEach((img) => {
          const preload = new Image();
          preload.src = img.src;
        });
      });
      el.addEventListener('click', () => openLightbox(i));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(i);
        }
      });
    });

    lbClose?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    lbPrev?.addEventListener('click', () => goToCase(-1));
    lbNext?.addEventListener('click', () => goToCase(1));

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') goToCase(-1);
      if (e.key === 'ArrowRight') goToCase(1);
    });
  })();
</script>
